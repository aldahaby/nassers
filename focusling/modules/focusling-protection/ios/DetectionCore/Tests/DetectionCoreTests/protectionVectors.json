        {
          "at": 0,
          "surface": "reels",
          "confidence": 0.9
        },
        {
          "at": 400,
          "surface": "reels",
          "confidence": 0.9
        },
        {
          "at": 800,
          "surface": "reels",
          "confidence": 0.9
        },
        {
          "at": 1600,
          "surface": "reels",
          "confidence": 0.9
        }
      ],
      "expectInterventionsAt": [
        1600
      ]
    },
    {
      "name": "old positives slide out of the window",
      "samples": [
        {
          "at": 0,
          "surface": "reels",
          "confidence": 0.9
        },
        {
          "at": 1000,
          "surface": "reels",
          "confidence": 0.9
        },
        {
          "at": 2000,
          "surface": "other",
          "confidence": 0.9
        },
        {
          "at": 3000,
          "surface": "other",
          "confidence": 0.9
