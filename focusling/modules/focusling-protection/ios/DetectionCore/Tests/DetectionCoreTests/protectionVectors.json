        {
          "at": 4000,
          "surface": "other",
          "confidence": 0.9
        },
        {
          "at": 5000,
          "surface": "other",
          "confidence": 0.9
        },
        {
          "at": 6000,
          "surface": "reels",
          "confidence": 0.9
        }
      ],
      "expectInterventionsAt": []
    },
    {
      "name": "cooldown suppresses repeat interventions, then detection resumes",
      "samples": [
        {
          "at": 0,
          "surface": "reels",
          "confidence": 0.9
        },
        {
          "at": 1000,
